    "grid": "#FFFFFF",
    "route": "#F2F2F2",
    "glow": "#3A3A3A",
    "pin": "#BDBDBD",
    "pinCore": "#FFFFFF",
    "text": "#FFFFFF",
    "accent": "#BDBDBD",
